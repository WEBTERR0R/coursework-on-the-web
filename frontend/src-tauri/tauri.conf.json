{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PharmaLab Guest",
  "version": "0.1.0",
  "identifier": "ru.pharmalab.guest",
  "build": {
    "beforeDevCommand": "npm run dev -- --mode tauri",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PharmaLab Guest",
        "width": 1200,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
